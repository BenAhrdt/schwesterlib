# Set the same generated password here and in DATABASE_URL (URL-encode if needed).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://schwesterlib:YOUR_DATABASE_PASSWORD@localhost:5432/schwesterlib
APP_URL=http://localhost:3000
# Production: exact public HTTPS origin, e.g. https://termine.example.org
# Keep this .env across updates; do not add .env.production/.env.local overrides.
# Generate independently: openssl rand -base64 48
SESSION_SECRET=
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional extra protection for initial setup; required in production
SETUP_KEY=
# Set only behind a reverse proxy that replaces X-Forwarded-For
TRUST_PROXY=false
# Set by scripts/install-web-updater.sh through systemd; do not set for development.
# UPDATE_REQUEST_PATH=/run/schwesterlib/requests/update-request
# UPDATE_STATUS_PATH=/run/schwesterlib/update-status.json
