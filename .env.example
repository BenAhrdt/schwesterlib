# Set the same generated password here and in DATABASE_URL (URL-encode if needed).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://schwesterlib:YOUR_DATABASE_PASSWORD@localhost:5432/schwesterlib
APP_URL=http://localhost:3000
# Generate independently: openssl rand -base64 48
SESSION_SECRET=
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional extra protection for initial setup; required in production
SETUP_KEY=
# Set only behind a reverse proxy that replaces X-Forwarded-For
TRUST_PROXY=false
