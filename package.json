    "iron-session": "^9.0.1",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
